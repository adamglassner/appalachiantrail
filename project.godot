; Engine configuration file.
config_version=5

[application]

config/name="The Appalachian Trail"
config/description="An Oregon Trail-style thru-hike from Springer Mountain, Georgia to Mount Katahdin, Maine."
config/version="1.3.0"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.3", "Forward Plus")
config/icon="res://branding/game_icon.png"
config/windows_native_icon="res://branding/game.ico"
boot_splash/bg_color=Color(0, 0.231, 0.184, 1)
boot_splash/image="res://branding/ironite_splash.png"
boot_splash/fullsize=true

[autoload]

Game="*res://scripts/game_state.gd"
Audio="*res://scripts/audio_manager.gd"

[display]

window/size/viewport_width=1600
window/size/viewport_height=900
window/size/resizable=true
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[gui]

common/snap_controls_to_pixels=true

[rendering]

renderer/rendering_method="forward_plus"
rendering_device/fallback_to_opengl3=true
anti_aliasing/quality/msaa_3d=2
anti_aliasing/quality/screen_space_aa=1
lights_and_shadows/directional_shadow/size=4096
lights_and_shadows/directional_shadow/soft_shadow_filter_quality=3
textures/vram_compression/import_etc2_astc=false
