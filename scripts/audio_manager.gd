extends Node
## Autoload "Audio": music with crossfades, ambience beds, footsteps, one-shot effects and volume settings.
## All audio lives in res://audio and is generated by tools/gen_audio.py.

const SETTINGS_PATH := "user://settings.json"
const NON_LOOPING := ["victory", "gameover"]
const MUSIC_DB := -5.0
## per-bed trims so every ambience sits at a similar loudness
const AMB_DB := {"night": 6.0, "town": 3.0, "rain": 0.0, "storm": -1.0, "forest": -1.0, "wind": -3.0, "river": -2.0}

var volumes := {"Master": 0.85, "Music": 0.7, "Ambience": 0.75, "SFX": 0.85}

var _music: Array[AudioStreamPlayer] = []
var _music_idx := 0
var _music_name := ""
var _amb: Array[AudioStreamPlayer] = []
var _amb_idx := 0
var _amb_name := ""
var _steps: AudioStreamPlayer
var _pool: Array[AudioStreamPlayer] = []
var _cache := {}
var _last_thunder := -100.0
var _last_click := 0


func _ready() -> void:
	process_mode = Node.PROCESS_MODE_ALWAYS
	for bus in ["Music", "Ambience", "SFX"]:
		if AudioServer.get_bus_index(bus) == -1:
			AudioServer.add_bus()
			var i := AudioServer.bus_count - 1
			AudioServer.set_bus_name(i, bus)
			AudioServer.set_bus_send(i, "Master")
	for i in 2:
		_music.append(_player("Music"))
		_amb.append(_player("Ambience"))
	_steps = _player("SFX")
	_steps.volume_db = -9.0
	for i in 10:
		_pool.append(_player("SFX"))
	_load_settings()
	_apply_volumes()


func _player(bus: String) -> AudioStreamPlayer:
	var p := AudioStreamPlayer.new()
	p.bus = bus
	add_child(p)
	return p


func _stream(path: String, loop: bool) -> AudioStream:
	if _cache.has(path):
		return _cache[path]
	if not ResourceLoader.exists(path):
		return null
	var s: AudioStream = load(path)
	if s is AudioStreamOggVorbis:
		(s as AudioStreamOggVorbis).loop = loop
	_cache[path] = s
	return s


# ------------------------------------------------------------------ music

func music(name: String, fade := 2.0) -> void:
	if name == _music_name:
		return
	_music_name = name
	var old := _music[_music_idx]
	_music_idx = 1 - _music_idx
	var nxt := _music[_music_idx]
	_fade_out(old, fade)
	if name == "":
		return
	var s := _stream("res://audio/music/%s.ogg" % name, not NON_LOOPING.has(name))
	if s == null:
		return
	nxt.stream = s
	nxt.volume_db = -40.0
	nxt.play()
	var tw := create_tween()
	tw.tween_property(nxt, "volume_db", MUSIC_DB, fade * 0.8)


func current_music() -> String:
	return _music_name


# ------------------------------------------------------------------ ambience

func ambience(name: String, fade := 2.5) -> void:
	if name == _amb_name:
		return
	_amb_name = name
	var old := _amb[_amb_idx]
	_amb_idx = 1 - _amb_idx
	var nxt := _amb[_amb_idx]
	_fade_out(old, fade)
	if name == "":
		return
	var s := _stream("res://audio/amb/%s.ogg" % name, true)
	if s == null:
		return
	nxt.stream = s
	nxt.volume_db = -40.0
	nxt.play(randf() * 10.0)
	var tw := create_tween()
	tw.tween_property(nxt, "volume_db", float(AMB_DB.get(name, 0.0)), fade)


func _fade_out(p: AudioStreamPlayer, fade: float) -> void:
	if not p.playing:
		return
	var tw := create_tween()
	tw.tween_property(p, "volume_db", -45.0, fade)
	tw.tween_callback(p.stop)


# ------------------------------------------------------------------ effects

func sfx(name: String, vol_db := 0.0, pitch_var := 0.04) -> void:
	var s := _stream("res://audio/sfx/%s.ogg" % name, false)
	if s == null:
		return
	var p: AudioStreamPlayer = null
	for c in _pool:
		if not c.playing:
			p = c
			break
	if p == null:
		p = _pool[0]
	p.stream = s
	p.volume_db = vol_db
	p.pitch_scale = 1.0 + randf_range(-pitch_var, pitch_var)
	p.play()


func click() -> void:
	var now := Time.get_ticks_msec()
	if now - _last_click < 40:
		return
	_last_click = now
	sfx("click", -4.0, 0.08)


## Thunder after a lightning flash; the delay sells the distance.
func thunder(strength := 1.0) -> void:
	var now := Time.get_ticks_msec() / 1000.0
	if now - _last_thunder < 2.5:
		return
	_last_thunder = now
	var pick := "thunder1" if strength > 0.85 else ("thunder2" if strength > 0.7 else "thunder3")
	var delay := randf_range(0.15, 0.6) if pick == "thunder1" else randf_range(0.6, 1.8)
	get_tree().create_timer(delay).timeout.connect(func(): sfx(pick, -2.0, 0.1))


func set_steps(on: bool) -> void:
	if on and not _steps.playing:
		_steps.stream = _stream("res://audio/sfx/steps.ogg", true)
		if _steps.stream is AudioStreamOggVorbis:
			(_steps.stream as AudioStreamOggVorbis).loop = true
		_steps.play()
	elif not on and _steps.playing:
		_steps.stop()


# ------------------------------------------------------------------ volume settings

func set_volume(bus: String, v: float) -> void:
	volumes[bus] = clampf(v, 0.0, 1.0)
	_apply_volumes()
	_save_settings()


func _apply_volumes() -> void:
	for bus in volumes:
		var i := AudioServer.get_bus_index(bus)
		if i == -1:
			continue
		var v: float = volumes[bus]
		AudioServer.set_bus_mute(i, v <= 0.001)
		AudioServer.set_bus_volume_db(i, linear_to_db(maxf(v, 0.001)))


func _load_settings() -> void:
	if not FileAccess.file_exists(SETTINGS_PATH):
		return
	var f := FileAccess.open(SETTINGS_PATH, FileAccess.READ)
	var d = JSON.parse_string(f.get_as_text())
	if typeof(d) == TYPE_DICTIONARY and d.has("volumes"):
		for k in d["volumes"]:
			if volumes.has(k):
				volumes[k] = float(d["volumes"][k])


func _save_settings() -> void:
	var f := FileAccess.open(SETTINGS_PATH, FileAccess.WRITE)
	if f:
		f.store_string(JSON.stringify({"volumes": volumes}))
